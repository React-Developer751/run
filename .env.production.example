# PRODUCTION template. Copy to .env on the server (loaded automatically by the engine).
# Needs Docker. Also give the dashboard web/.env.local: NEXT_PUBLIC_API_URL and NEXT_PUBLIC_SITE_URL (see web/.env.example).

NODE_ENV=production
# Users' apps live at <slug>.yourapps.app. Use a DIFFERENT domain from the dashboard/API (yourdomain.com):
# the engine refuses to start in production if they share one (override: HOSTX_ALLOW_SHARED_DOMAIN=true).
HOSTX_BASE_DOMAIN=yourapps.app
HOSTX_PROXY_PORT=8080                   # app proxy (put Caddy/nginx with TLS in front of it)
HOSTX_PROXY_HOST=127.0.0.1              # only Caddy/nginx may reach the app proxy
HOSTX_PUBLIC_SCHEME=https               # what dashboard URLs show
HOSTX_PUBLIC_PORT=443
HOSTX_API_PORT=4000
HOSTX_API_HOST=127.0.0.1                # keep on loopback; expose through the reverse proxy
HOSTX_WEB_ORIGIN=https://app.yourdomain.com
HOSTX_SECRET=change-me   # >= 32 chars (openssl rand -hex 32). Do not change later: encrypted env vars depend on it
HOSTX_RUNNER=docker                     # production must use Docker
HOSTX_ALLOW_SIGNUP=true                 # set false after creating your accounts
HOSTX_MAX_PROJECTS=5
HOSTX_APP_MEMORY=300m
HOSTX_APP_CPUS=0.5
HOSTX_POLL_SECONDS=60                  # auto-deploy polling; 0 disables
HOSTX_API_PUBLIC_URL=https://api.yourdomain.com   # shown as the GitHub webhook URL
HOSTX_ADMIN_EMAIL=you@example.com     # this account always gets the admin role (the first account does too)
HOSTX_TRUST_PROXY=true                 # ONLY when the API sits behind your own Caddy/nginx (real client IP for rate limits)
HOSTX_COOKIE_SECURE=auto              # true | false | auto (auto = Secure in production)
HOSTX_ACCESS_TTL_SECONDS=900
HOSTX_REFRESH_TTL_DAYS=30

# MongoDB add-on (needs Docker): one shared mongo container, a separate database + user per project.
HOSTX_MONGO=on                         # off disables it
HOSTX_MONGO_IMAGE=mongo:8.0
HOSTX_MONGO_MEMORY=1g                  # hard memory cap of the mongo container
HOSTX_MONGO_CACHE_GB=0.25              # WiredTiger cache; keep well below HOSTX_MONGO_MEMORY
# HOSTX_MONGO_ADMIN_URI=mongodb://admin:pass@db.internal:27017/?authSource=admin   # use your own Mongo server instead

# Links in emails point here (defaults to the first HOSTX_WEB_ORIGIN).
HOSTX_DASHBOARD_URL=https://app.yourdomain.com
# Email (verification + forgot password). Any SMTP provider. Turning it on makes email verification required.
HOSTX_SMTP_URL=smtps://USER:PASS@smtp.provider.com:465
HOSTX_MAIL_FROM="HostX <no-reply@yourdomain.com>"
# HOSTX_REQUIRE_VERIFIED_EMAIL=true
# Cloudflare Turnstile CAPTCHA on sign-up / forgot password (also set NEXT_PUBLIC_TURNSTILE_SITE_KEY for the dashboard).
# HOSTX_TURNSTILE_SECRET=
# GitHub App (private repos). Callback URL: https://api.yourdomain.com/api/auth/github/callback
# HOSTX_GITHUB_APP_ID=
# HOSTX_GITHUB_APP_SLUG=
# HOSTX_GITHUB_CLIENT_ID=
# HOSTX_GITHUB_CLIENT_SECRET=
# HOSTX_GITHUB_WEBHOOK_SECRET=
# HOSTX_GITHUB_PRIVATE_KEY_FILE=/opt/hostx/github-app.pem

# Billing (Razorpay Subscriptions). Plans and their limits apply only when these are set. Use rzp_test_ keys first.
# HOSTX_RAZORPAY_KEY_ID=rzp_live_...
# HOSTX_RAZORPAY_KEY_SECRET=
# HOSTX_RAZORPAY_WEBHOOK_SECRET=        # Webhook URL: https://api.yourdomain.com/api/billing/webhook
# HOSTX_RAZORPAY_PLAN_STARTER=plan_...
# HOSTX_RAZORPAY_PLAN_PRO=plan_...
# Optional overrides (see src/config/plans.ts): HOSTX_PRICE_STARTER=299 HOSTX_PRICE_PRO=999 HOSTX_FREE_SLEEP_MINUTES=15 ...

# Custom domains: public IPv4 of this server (shown as the A record for root domains like myshop.com).
# HOSTX_PUBLIC_IP=203.0.113.10
# HOSTX_DNS_SERVERS=1.1.1.1,8.8.8.8
