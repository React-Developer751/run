# /etc/systemd/system/hostx-engine.service  (adjust paths/user)
[Unit]
Description=HostX engine
After=network-online.target docker.service
Requires=docker.service

[Service]
WorkingDirectory=/opt/hostx
# Node.js 22.13+ (built-in SQLite). The flag only hides node:sqlite's "experimental" notice.
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning dist/index.js
Restart=always
RestartSec=3
User=hostx
Group=docker
Environment=NODE_ENV=production
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
