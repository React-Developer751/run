# ════════════════════════════════════════════════════════════════════════════════
# HostX DASHBOARD (Next.js) — every setting you have to provide yourself (names only, no values).
#
#   cp web/.env.template web/.env.local     then write your values after the "=" signs, then build.
#
# These are baked into the pages at build time (npm run build): rebuild after changing them.
# None of them is secret (public URLs and business details), but web/.env.local stays out of git anyway.
# A line left empty counts as "not set": localhost URLs, and a visible [placeholder] on the legal pages.
# ════════════════════════════════════════════════════════════════════════════════

# ── URLs — REQUIRED in production ─────────────────────────────────────────────────
# Engine API, e.g. https://api.yourdomain.com
NEXT_PUBLIC_API_URL=
# This dashboard, e.g. https://app.yourdomain.com
NEXT_PUBLIC_SITE_URL=
# Optional: engine address the dashboard server uses to read the website name (default: NEXT_PUBLIC_API_URL)
HOSTX_INTERNAL_API_URL=

# ── Business details — optional: easier to fill in Admin → Settings → Business details (admin values win) ──
NEXT_PUBLIC_LEGAL_COMPANY=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_LEGAL_EMAIL=
NEXT_PUBLIC_LEGAL_PHONE=
NEXT_PUBLIC_LEGAL_ABUSE_EMAIL=
NEXT_PUBLIC_LEGAL_GRIEVANCE_OFFICER=
NEXT_PUBLIC_LEGAL_GRIEVANCE_EMAIL=
NEXT_PUBLIC_LEGAL_JURISDICTION=
NEXT_PUBLIC_LEGAL_UPDATED=
