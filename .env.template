# ════════════════════════════════════════════════════════════════════════════════
# HostX ENGINE — every setting you have to provide yourself (names only, no values).
#
#   cp .env.template .env      then write your values after the "=" signs.
#
# The engine reads .env on start. NEVER commit .env (it is gitignored); only this template is in git.
# A line left empty (KEY=) counts as "not set": the engine uses its default or keeps that feature off.
# Local development needs none of this: everything has a default, and the master secret is generated
# into data/secret.key on first start. Fill these in on the production server.
# Full list with defaults and limits: .env.production.example · details: README.md
# ════════════════════════════════════════════════════════════════════════════════

# ── Server mode (production) ──────────────────────────────────────────────────────
# production + docker on the live server. Leave empty on your laptop.
NODE_ENV=
HOSTX_RUNNER=

# ── Master secret — REQUIRED in production ────────────────────────────────────────
# 64 random characters: openssl rand -hex 32
# Set once, never change it: users' encrypted env vars can only be read with this value. Keep a backup.
HOSTX_SECRET=

# ── Domains & server — REQUIRED in production ─────────────────────────────────────
# Apps domain, different from the dashboard domain, e.g. yourapps.app (wildcard DNS *.yourapps.app → server IP)
HOSTX_BASE_DOMAIN=
# Dashboard URL, e.g. https://app.yourdomain.com
HOSTX_WEB_ORIGIN=
HOSTX_DASHBOARD_URL=
# Engine API URL, e.g. https://api.yourdomain.com
HOSTX_API_PUBLIC_URL=
# Public IPv4 of the server (VPS panel)
HOSTX_PUBLIC_IP=
# https and 443 behind Caddy/nginx
HOSTX_PUBLIC_SCHEME=
HOSTX_PUBLIC_PORT=
# true only when the API sits behind your own Caddy/nginx
HOSTX_TRUST_PROXY=

# ── Admin ─────────────────────────────────────────────────────────────────────────
# This account always gets the admin role (after verifying its email)
HOSTX_ADMIN_EMAIL=
# true / false: allow new sign-ups
HOSTX_ALLOW_SIGNUP=

# ── Email (SMTP) — needed for verification, forgot password, alerts, support replies ──
# From your mail provider (Brevo, Amazon SES, Zoho ...): smtps://USER:PASSWORD@smtp.host.com:465
HOSTX_SMTP_URL=
# Sender, e.g. "HostX <no-reply@yourdomain.com>"
HOSTX_MAIL_FROM=

# ── GitHub App — optional: private repos, "Continue with GitHub", instant deploys ──
# github.com → Settings → Developer settings → GitHub Apps → your app
HOSTX_GITHUB_APP_ID=
HOSTX_GITHUB_APP_SLUG=
HOSTX_GITHUB_CLIENT_ID=
HOSTX_GITHUB_CLIENT_SECRET=
HOSTX_GITHUB_WEBHOOK_SECRET=
# Path of the downloaded .pem private key on the server (or HOSTX_GITHUB_PRIVATE_KEY with the key on one line)
HOSTX_GITHUB_PRIVATE_KEY_FILE=

# ── Razorpay — optional: paid plans (without these everyone uses the Free limits) ─
# Razorpay Dashboard → Account & Settings → API Keys (use rzp_test_ keys first)
HOSTX_RAZORPAY_KEY_ID=
HOSTX_RAZORPAY_KEY_SECRET=
# Razorpay → Webhooks → the secret you typed there
HOSTX_RAZORPAY_WEBHOOK_SECRET=
# Razorpay → Subscriptions → Plans → plan_... ids
HOSTX_RAZORPAY_PLAN_STARTER=
HOSTX_RAZORPAY_PLAN_PRO=
