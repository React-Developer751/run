{
  "name": "hostx-engine",
  "version": "1.0.0",
  "description": "HostX - self-hosted mini Render for MERN projects",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node --disable-warning=ExperimentalWarning dist/index.js",
    "dev": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx watch src/index.ts",
    "make-admin": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx src/scripts/make-admin.ts"
  },
  "engines": {
    "node": ">=22.13"
  },
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "5.5.4"
  }
}
