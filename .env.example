# Local DEVELOPMENT settings. Copy to .env if you want to change something; every value below is optional
# and shows the default. Production settings live in .env.production.example.

# HOSTX_API_PORT=4000
# HOSTX_PROXY_PORT=8080                 # apps open at http://<name>.localhost:8080
# HOSTX_WEB_ORIGIN=http://localhost:3000
# HOSTX_POLL_SECONDS=60                 # auto-deploy: check GitHub for new commits (0 = off)
# HOSTX_RUNNER=auto                     # auto | docker | process (process = no isolation, dev only)
# HOSTX_MAX_PROJECTS=5
# HOSTX_ADMIN_EMAIL=                    # this account is admin (the first account to register is admin too)
